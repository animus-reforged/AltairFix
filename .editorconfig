# EditorConfig for AltairFix.
# C++ formatting is defined by .clang-format; this file covers shared editor
# behavior and non-C++ files.

root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = false
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
tab_width = 4

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# C++ style lives in .clang-format. Keep only settings here that apply to
# every editor and cannot be expressed by clang-format.

[*.{axaml,xaml,xml}]
## Keep the first attribute on the same line as the element name;
## wrap subsequent attributes onto lines aligned with it.
resharper_xml_attribute_style = first_attribute_on_single_line
resharper_xml_attribute_indent = align_by_first_attribute

## Allow deeply nested elements to keep the first attribute on the tag line.
resharper_xml_max_line_length = 320